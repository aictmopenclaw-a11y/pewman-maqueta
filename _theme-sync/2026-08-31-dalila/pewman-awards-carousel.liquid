{%- liquid
  assign logo_count = 0
  for block in section.blocks
    if block.type == 'award_logo' and block.settings.logo
      assign logo_count = logo_count | plus: 1
    endif
  endfor
  assign marquee_duration = logo_count | times: 4 | at_least: 12
-%}
{%- style -%}
  #PewmanAwards-{{ section.id }} { background: #fff; padding-top: 0; padding-bottom: 64px; }
  #PewmanAwards-{{ section.id }} .pewman-awards__top { display: grid; grid-template-columns: 1fr 1fr; align-items: center; max-width: 1200px; margin: 0 auto 46px; padding: 0 24px; }
  #PewmanAwards-{{ section.id }} .pewman-awards__tx { padding: 60px 56px; }
  #PewmanAwards-{{ section.id }} .pewman-awards__tx h2 { font-size: clamp(26px, 3.4vw, 38px); color: var(--pewman-tinta); margin-bottom: 18px; }
  #PewmanAwards-{{ section.id }} .pewman-awards__tx p { font-size: 16px; color: var(--pewman-gris-tx); max-width: 450px; margin: 0; }
  #PewmanAwards-{{ section.id }} .pewman-awards__star { display: flex; align-items: center; justify-content: center; gap: 26px; padding: 18px 40px; }
  #PewmanAwards-{{ section.id }} .pewman-awards__star img { max-width: 380px; width: 100%; height: auto; }
  #PewmanAwards-{{ section.id }} .pewman-awards__star--duo img { width: auto; max-width: 46%; max-height: 320px; }
  #PewmanAwards-{{ section.id }} .pewman-awards__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanAwards-{{ section.id }} .pewman-awards__marquee {
    overflow: hidden; padding: 8px 0 16px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent);
  }
  #PewmanAwards-{{ section.id }} .pewman-awards__track {
    display: flex; gap: 20px; width: max-content;
    animation: pewmanAwardsMarquee-{{ section.id }} {{ marquee_duration }}s linear infinite;
  }
  #PewmanAwards-{{ section.id }} .pewman-awards__marquee:hover .pewman-awards__track,
  #PewmanAwards-{{ section.id }} .pewman-awards__marquee:focus-within .pewman-awards__track { animation-play-state: paused; }
  @keyframes pewmanAwardsMarquee-{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  #PewmanAwards-{{ section.id }} .pewman-awards__logo {
    flex: 0 0 auto; width: 225px; height: 180px; background: #fff; border: 1px solid var(--pewman-linea); border-radius: 14px;
    display: flex; align-items: center; justify-content: center; padding: 24px; transition: .2s;
  }
  #PewmanAwards-{{ section.id }} .pewman-awards__logo:hover { box-shadow: var(--pewman-sh); transform: translateY(-4px); }
  #PewmanAwards-{{ section.id }} .pewman-awards__logo img { max-height: 117px; max-width: 180px; object-fit: contain; }
  @media (prefers-reduced-motion: reduce) {
    #PewmanAwards-{{ section.id }} .pewman-awards__track { animation: none; }
    #PewmanAwards-{{ section.id }} .pewman-awards__logo[aria-hidden="true"] { display: none; }
    #PewmanAwards-{{ section.id }} .pewman-awards__marquee { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
  }
  @media (max-width: 820px) {
    #PewmanAwards-{{ section.id }} .pewman-awards__top { grid-template-columns: 1fr; }
    #PewmanAwards-{{ section.id }} .pewman-awards__tx { padding: 40px 24px 10px; }
  }
{%- endstyle -%}

<div id="PewmanAwards-{{ section.id }}" aria-label="Premios">
  <div class="pewman-awards__top">
    <div class="pewman-awards__tx">
      <h2>{{ section.settings.heading | default: 'Premios que respaldan nuestra ciencia' }}</h2>
      <div class="pewman-awards__rte">{{ section.settings.text }}</div>
    </div>
    {%- if section.settings.featured_image -%}
      <div class="pewman-awards__star{% if section.settings.featured_image_2 %} pewman-awards__star--duo{% endif %}">
        <img src="{{ section.settings.featured_image | image_url: width: 1200 }}" alt="{{ section.settings.featured_image.alt | escape }}" loading="lazy">
        {%- if section.settings.featured_image_2 -%}
          <img src="{{ section.settings.featured_image_2 | image_url: width: 1200 }}" alt="{{ section.settings.featured_image_2.alt | escape }}" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <div class="pewman-awards__wrap">
    <div class="pewman-awards__marquee">
      <div class="pewman-awards__track">
        {%- for pass in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'award_logo' and block.settings.logo -%}
              <div class="pewman-awards__logo" {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                <img src="{{ block.settings.logo | image_url: width: 360 }}" alt="{{ block.settings.alt | escape }}" loading="lazy">
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Premios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Premios que respaldan nuestra ciencia" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "image_picker", "id": "featured_image", "label": "Imagen destacada (ej. sello de premio principal)" },
    { "type": "image_picker", "id": "featured_image_2", "label": "Segunda imagen destacada (opcional, queda al lado de la primera)" }
  ],
  "blocks": [
    {
      "type": "award_logo",
      "name": "Logo de premio",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pewman · Premios",
      "settings": { "text": "<p>Pewman fue reconocido con el Premio Avonni en la categoría Transferencia Tecnológica, destacando su capacidad de transformar investigación científica en soluciones biotecnológicas aplicables para la agricultura.</p>" },
      "blocks": [
        { "type": "award_logo" },
        { "type": "award_logo" },
        { "type": "award_logo" }
      ]
    }
  ]
}
{% endschema %}
