{%- comment -%}
  Bandera SVG inline normalizada (30x20) o globo para "Internacional".
  Uso: {% render 'pewman-flag', country: 'chile' %}
  Valores: intl · usa · chile · india. Cualquier otro valor cae en un candado neutro.
  Réplica exacta de los SVG de la maqueta (empresa.html / patentes-papers.html).
{%- endcomment -%}
{%- case country -%}
{%- when 'intl' -%}
<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M5 6.5 Q12 9 19 6.5"/><path d="M5 17.5 Q12 15 19 17.5"/></svg>
{%- when 'usa' -%}
<svg viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="30" height="20" fill="#fff"/><rect width="30" height="1.54" y="0" fill="#B22234"/><rect width="30" height="1.54" y="3.08" fill="#B22234"/><rect width="30" height="1.54" y="6.15" fill="#B22234"/><rect width="30" height="1.54" y="9.23" fill="#B22234"/><rect width="30" height="1.54" y="12.31" fill="#B22234"/><rect width="30" height="1.54" y="15.38" fill="#B22234"/><rect width="30" height="1.54" y="18.46" fill="#B22234"/><rect width="12" height="10.77" fill="#3C3B6E"/><circle cx="2" cy="1.7" r="0.55" fill="#fff"/><circle cx="5" cy="1.7" r="0.55" fill="#fff"/><circle cx="8" cy="1.7" r="0.55" fill="#fff"/><circle cx="10.7" cy="1.7" r="0.55" fill="#fff"/><circle cx="3.5" cy="3.6" r="0.55" fill="#fff"/><circle cx="6.5" cy="3.6" r="0.55" fill="#fff"/><circle cx="9.5" cy="3.6" r="0.55" fill="#fff"/><circle cx="2" cy="5.5" r="0.55" fill="#fff"/><circle cx="5" cy="5.5" r="0.55" fill="#fff"/><circle cx="8" cy="5.5" r="0.55" fill="#fff"/><circle cx="10.7" cy="5.5" r="0.55" fill="#fff"/><circle cx="3.5" cy="7.4" r="0.55" fill="#fff"/><circle cx="6.5" cy="7.4" r="0.55" fill="#fff"/><circle cx="9.5" cy="7.4" r="0.55" fill="#fff"/><circle cx="2" cy="9.3" r="0.55" fill="#fff"/><circle cx="5" cy="9.3" r="0.55" fill="#fff"/><circle cx="8" cy="9.3" r="0.55" fill="#fff"/><circle cx="10.7" cy="9.3" r="0.55" fill="#fff"/></svg>
