{%- style -%}
  #PewmanCtaBand-{{ section.id }} { background: linear-gradient(160deg, #343434, #242424); color: #fff; text-align: center; padding: 78px 0; }
  #PewmanCtaBand-{{ section.id }} .pewman-ctaband__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanCtaBand-{{ section.id }} h2 { font-size: clamp(26px, 3.4vw, 36px); color: #fff; margin-bottom: 14px; }
  #PewmanCtaBand-{{ section.id }} p { font-size: 17px; color: #d6d6d6; max-width: 560px; margin: 0 auto 26px; }
  #PewmanCtaBand-{{ section.id }} .pewman-ctaband__cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  {%- if section.settings.background_image -%}
  #PewmanCtaBand-{{ section.id }} { position: relative; overflow: hidden; background: #1c1c1c; }
  #PewmanCtaBand-{{ section.id }}::before { content: ""; position: absolute; inset: 0; background: url({{ section.settings.background_image | image_url: width: 2560 }}) center/cover no-repeat; }
  {%- comment -%}
    Oscurecido regulable (Cris 2026-08-18): el overlay fijo era muy suave y
    asumia fotos oscuras. Con una foto clara (ej. placas de laboratorio) el
    texto blanco se perdia. Ahora el equipo lo ajusta segun la foto que cargue.
  {%- endcomment -%}
  {%- assign ov = section.settings.overlay_opacity | default: 55 | divided_by: 100.0 -%}
  #PewmanCtaBand-{{ section.id }}::after { content: ""; position: absolute; inset: 0; background: linear-gradient(160deg, rgba(16,20,16,{{ ov }}), rgba(10,12,10,{{ ov | minus: 0.06 }})); }
  #PewmanCtaBand-{{ section.id }} .pewman-ctaband__wrap { position: relative; z-index: 1; }
  #PewmanCtaBand-{{ section.id }} h2 { text-shadow: 0 2px 14px rgba(0,0,0,.65), 0 1px 4px rgba(0,0,0,.5); }
  #PewmanCtaBand-{{ section.id }} p { color: #eef1ee; text-shadow: 0 1px 8px rgba(0,0,0,.6); }
  {%- endif -%}
  {% if section.settings.background_image %}@media (max-width: 749px) { #PewmanCtaBand-{{ section.id }}::before { background: url({{ section.settings.background_image | image_url: width: 1080 }}) center/cover no-repeat; } }{% endif %}
{%- endstyle -%}

<div id="PewmanCtaBand-{{ section.id }}">
  <div class="pewman-ctaband__wrap">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="pewman-ctaband__cta">
      {%- if section.settings.button_1_label != blank -%}
        {% render 'pewman-cta-button', text: section.settings.button_1_label, url: section.settings.button_1_link, variant: 'light' %}
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        {% render 'pewman-cta-button', text: section.settings.button_2_label, url: section.settings.button_2_link, variant: 'ghost' %}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Banda CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_1_label", "label": "Botón 1 — texto" },
    { "type": "url", "id": "button_1_link", "label": "Botón 1 — link" },
    { "type": "text", "id": "button_2_label", "label": "Botón 2 — texto" },
    { "type": "url", "id": "button_2_link", "label": "Botón 2 — link" },
    { "type": "image_picker", "id": "background_image", "label": "Foto de fondo (opcional)", "info": "Con foto, el texto lleva sombra para mantener la legibilidad" },
    { "type": "range", "id": "overlay_opacity", "label": "Oscurecer la foto", "min": 0, "max": 85, "step": 5, "unit": "%", "default": 55, "info": "Súbelo si la foto es clara y el texto no se lee bien.", "visible_if": "{{ section.settings.background_image != blank }}" }
  ],
  "presets": [
    { "name": "Pewman · Banda CTA" }
  ]
}
{% endschema %}