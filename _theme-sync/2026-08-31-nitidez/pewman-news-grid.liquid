{%- liquid
  assign use_blog = false
  if section.settings.source == 'blog' and section.settings.blog != blank
    assign the_blog = blogs[section.settings.blog]
    if the_blog.articles_count > 0
      assign use_blog = true
    endif
  endif
-%}
{%- style -%}
  #PewmanNews-{{ section.id }} { background: #fff; padding: 78px 0; }
  #PewmanNews-{{ section.id }}.pewman-news--tight { padding-top: 0; }
  #PewmanNews-{{ section.id }} .pewman-news__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanNews-{{ section.id }} .pewman-news__intro { max-width: 680px; margin: 0 0 30px; font-size: 16.5px; color: var(--pewman-gris-tx); line-height: 1.5; }
  #PewmanNews-{{ section.id }} .pewman-news__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  #PewmanNews-{{ section.id }} .pewman-news__card { border-radius: 16px; overflow: hidden; position: relative; height: 230px; box-shadow: var(--pewman-sh); display: block; }
  #PewmanNews-{{ section.id }} .pewman-news__card img { width: 100%; height: 100%; object-fit: cover; }
  #PewmanNews-{{ section.id }} .pewman-news__card::after { content: ""; position: absolute; inset: 0; background: rgba(52,52,52,.55); transition: .3s; }
  #PewmanNews-{{ section.id }} .pewman-news__card:hover::after { background: rgba(52,52,52,.2); }
  #PewmanNews-{{ section.id }} .pewman-news__content { position: absolute; left: 0; right: 0; bottom: 0; padding: 30px 18px 16px; z-index: 2; color: #fff; }
  #PewmanNews-{{ section.id }} .pewman-news__source {
    font-weight: 700; font-size: 11.5px; text-transform: uppercase; letter-spacing: .06em; color: #fff;
    background: var(--pewman-rojo); display: inline-block; padding: 3px 9px; border-radius: 4px; margin-bottom: 7px;
  }
  #PewmanNews-{{ section.id }} .pewman-news__content h3 { font-size: 15.5px; color: #fff; line-height: 1.3; margin: 0; }
  #PewmanNews-{{ section.id }} .pewman-news__more { text-align: center; margin-top: 32px; }
  @media (max-width: 860px) { #PewmanNews-{{ section.id }} .pewman-news__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { #PewmanNews-{{ section.id }} .pewman-news__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}

<div id="PewmanNews-{{ section.id }}" class="{% if section.settings.tight_top %}pewman-news--tight{% endif %}">
  <div class="pewman-news__wrap">
    {%- if section.settings.heading != blank -%}
      {% render 'pewman-section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subtext: section.settings.subtext %}
    {%- elsif section.settings.subtext != blank -%}
      <p class="pewman-news__intro">{{ section.settings.subtext }}</p>
    {%- endif -%}
    <div class="pewman-news__grid">
      {%- if use_blog -%}
        {%- for article in the_blog.articles limit: section.settings.max_articles -%}
          <a class="pewman-news__card" href="{{ article.url }}">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 1000 }}" alt="{{ article.title | escape }}" loading="lazy">
            {%- endif -%}
            <div class="pewman-news__content">
              {%- if article.tags.size > 0 -%}<span class="pewman-news__source">{{ article.tags.first }}</span>{%- endif -%}
              <h3>{{ article.title }}</h3>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'news_card' -%}
          <a class="pewman-news__card" href="{{ block.settings.link | default: '#' }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- endif -%}
            <div class="pewman-news__content">
              {%- if block.settings.source_label != blank -%}<span class="pewman-news__source">{{ block.settings.source_label }}</span>{%- endif -%}
              <h3>{{ block.settings.title }}</h3>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if use_blog and section.settings.show_view_all -%}
      <div class="pewman-news__more">
        {% render 'pewman-cta-button', text: section.settings.view_all_label | default: 'Ver todas las noticias', url: the_blog.url, variant: 'light' %}
      </div>
    {%- elsif section.settings.view_all_link != blank -%}
      <div class="pewman-news__more">
        {% render 'pewman-cta-button', text: section.settings.view_all_label | default: 'Ver todas las noticias', url: section.settings.view_all_link, variant: 'light' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Noticias",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Origen del contenido",
      "options": [
        { "value": "blog", "label": "Blog de Shopify (recomendado)" },
        { "value": "manual", "label": "Tarjetas fijas" }
      ],
      "default": "manual",
      "info": "Con el blog, publicas desde Contenido y aparecen solas acá"
    },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "max_articles", "label": "Cuántas mostrar", "min": 3, "max": 12, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar botón Ver todas", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (opcional)" },
    { "type": "text", "id": "heading", "label": "Título", "info": "Déjalo vacío para no mostrar título (p. ej. la grilla que va justo bajo el hero)" },
    { "type": "textarea", "id": "subtext", "label": "Texto / intro (opcional)" },
    { "type": "checkbox", "id": "tight_top", "label": "Sin padding superior", "info": "Cuando va justo después de otra grilla de noticias", "default": false },
    { "type": "url", "id": "view_all_link", "label": "Link Ver todas" },
    { "type": "text", "id": "view_all_label", "label": "Texto del botón Ver todas", "default": "Ver todas las noticias" }
  ],
  "blocks": [
    {
      "type": "news_card",
      "name": "Noticia",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "source_label", "label": "Fuente (badge)", "info": "Ej. El Mercurio Campo, Diario Financiero, Paper, Artículo" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Abrir en pestaña nueva", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pewman · Prensa (home)",
      "blocks": [
        { "type": "news_card", "settings": { "source_label": "El Mercurio Campo", "title": "La biotecnología antiheladas que nació de la Antártica." } },
        { "type": "news_card", "settings": { "source_label": "Diario Financiero", "title": "Biotech chilena escala con biofortificantes de bacterias." } },
        { "type": "news_card", "settings": { "source_label": "Redagrícola", "title": "Microorganismos extremos al servicio del agro." } }
      ]
    },
    {
      "name": "Pewman · Artículos (home)",
      "settings": { "heading": "Artículos", "tight_top": true },
      "blocks": [
        { "type": "news_card", "settings": { "source_label": "Paper", "title": "Bacterias antárticas como agentes crioprotectores en cultivos frutales." } },
        { "type": "news_card", "settings": { "source_label": "Artículo", "title": "Eficiencia hídrica con nanoburbujas de oxígeno y microorganismos extremófilos." } },
        { "type": "news_card", "settings": { "source_label": "Paper", "title": "Respuesta sistémica del cultivo frente al estrés térmico por helada." } }
      ]
    }
  ]
}
{% endschema %}
