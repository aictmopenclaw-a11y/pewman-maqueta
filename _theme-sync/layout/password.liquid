<!doctype html>
<html class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- render 'meta-tags' -%}
    {{ content_for_header }}
    <style>
      :root{
        --pewman-rojo:#BD0028; --pewman-rojo-d:#a12423; --pewman-tinta:#343434;
        --pewman-linea:rgba(255,255,255,.14);
      }
      *{box-sizing:border-box}
      html,body{margin:0;padding:0}
      body{
        min-height:100vh; display:flex; align-items:center; justify-content:center; padding:32px 20px;
        font-family:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
        color:#eafaf2; position:relative; overflow:hidden;
        background:linear-gradient(155deg,#2b2b2b,#3d3d3d);
      }
      body::before{
        content:""; position:absolute; inset:0; pointer-events:none;
        background:
          radial-gradient(680px 360px at 86% 6%,rgba(189,0,40,.30),transparent 62%),
          radial-gradient(600px 460px at 6% 96%,rgba(255,255,255,.05),transparent 60%);
      }
      .pw{position:relative; z-index:1; width:100%; max-width:480px; text-align:center}
      .pw__logo{height:60px; width:auto; margin:0 auto 30px; display:block; filter:brightness(0) invert(1)}
      .pw__kicker{
        display:inline-block; font-weight:700; font-size:11.5px; letter-spacing:.16em; text-transform:uppercase;
        color:#fff; background:var(--pewman-rojo); padding:6px 14px; border-radius:4px; margin-bottom:20px;
      }
      .pw__title{font-size:clamp(26px,4.4vw,36px); line-height:1.12; color:#fff; margin:0 0 14px; font-weight:700}
      .pw__text{font-size:15.5px; line-height:1.55; color:#d6d6d6; margin:0 auto 30px; max-width:380px}
      .pw__form{display:flex; gap:10px; max-width:420px; margin:0 auto; flex-wrap:wrap}
      .pw__input{
        flex:1; min-width:180px; border:1.5px solid var(--pewman-linea); background:rgba(255,255,255,.06);
        color:#fff; border-radius:100px; padding:14px 20px; font-size:15px; font-family:inherit; transition:.18s;
      }
      .pw__input::placeholder{color:#b8b8b8}
      .pw__input:focus{outline:none; border-color:var(--pewman-rojo); background:rgba(255,255,255,.10); box-shadow:0 0 0 3px rgba(189,0,40,.25)}
      .pw__btn{
        border:none; cursor:pointer; font-family:inherit; font-weight:600; font-size:15px; color:#fff;
        background:var(--pewman-rojo); border-radius:100px; padding:14px 30px; transition:.2s;
      }
      .pw__btn:hover{background:var(--pewman-rojo-d); transform:translateY(-2px)}
      .pw__error{
        margin:14px auto 0; font-size:13.5px; color:#ffb4b4; display:flex; gap:7px; align-items:center; justify-content:center;
      }
      .pw__foot{margin-top:34px; font-size:13px; color:#9a9a9a}
      .pw__foot a{color:#cfcfcf; text-decoration:underline; text-underline-offset:2px}
      .pw__foot a:hover{color:#fff}
      @media(max-width:520px){ .pw__form{flex-direction:column} .pw__btn{width:100%} }
    </style>
  </head>

  <body class="pewman-password">
    <main class="pw" role="main">
      <img class="pw__logo" src="https://cdn.shopify.com/s/files/1/0798/6348/0551/files/logo-pewman-hz.png" alt="Pewman Innovation" width="220" height="60">
      <span class="pw__kicker">Sitio en preparación</span>
      <h1 class="pw__title">Biotecnología para proteger y potenciar tus cultivos</h1>
      <p class="pw__text">Estamos afinando los últimos detalles de nuestro nuevo sitio. Si tienes la contraseña de acceso, ingrésala para previsualizarlo.</p>

      {%- form 'storefront_password' -%}
        <div class="pw__form">
          <label for="password" class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Contraseña</label>
          <input
            type="password"
            name="password"
            id="password"
            class="pw__input"
            autocomplete="current-password"
            placeholder="Ingresa la contraseña"
            {% if form.errors %}aria-invalid="true"{% endif %}
            autofocus
          >
          <button type="submit" class="pw__btn">Entrar</button>
        </div>
        {%- if form.errors -%}
          <div class="pw__error" tabindex="-1">Contraseña incorrecta. Inténtalo de nuevo.</div>
        {%- endif -%}
      {%- endform -%}

      <div class="pw__foot">
        ¿Eres del equipo Pewman? <a href="/admin" rel="nofollow">Ingresar al panel</a>
      </div>
    </main>

    {%- comment -%} Requerido por Shopify en el layout de password; ocultamos el contenido nativo para usar el diseño Pewman de arriba. {%- endcomment -%}
    <div hidden aria-hidden="true" style="display:none !important">{{ content_for_layout }}</div>
  </body>
</html>
