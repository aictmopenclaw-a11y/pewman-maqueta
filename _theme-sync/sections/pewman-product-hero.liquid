{%- style -%}
  #PewmanProductHero-{{ section.id }} {
    position: relative; overflow: hidden; background: #101820; margin-top: 0;
    --pewman-prod: {{ section.settings.product_accent_color | default: '#1499c7' }};
  }
  #PewmanProductHero-{{ section.id }} .pewman-phero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; animation: pewmanPHeroZoom-{{ section.id }} 20s ease-out infinite alternate; }
  @keyframes pewmanPHeroZoom-{{ section.id }} { from { transform: scale(1); } to { transform: scale(1.09); } }
  @media (prefers-reduced-motion: reduce) { #PewmanProductHero-{{ section.id }} .pewman-phero__bg { animation: none; } }
  #PewmanProductHero-{{ section.id }}::after {
    content: ""; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(90deg, rgba(12,18,26,.88) 0%, rgba(12,18,26,.62) 42%, rgba(12,18,26,.26) 72%, rgba(12,18,26,.06) 100%);
  }
  #PewmanProductHero-{{ section.id }} .pewman-phero__inner {
    position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 0 24px;
    min-height: clamp(520px, 54vw, 760px); display: flex; flex-direction: column; justify-content: center;
  }
  #PewmanProductHero-{{ section.id }} .pewman-phero__logo { height: 52px; width: auto; margin-bottom: 24px; align-self: flex-start; }
  #PewmanProductHero-{{ section.id }} .pewman-phero__heading { font-size: clamp(30px, 4.4vw, 50px); color: #fff; max-width: 640px; margin-bottom: 16px; line-height: 1.08; }
  #PewmanProductHero-{{ section.id }} .pewman-phero__body { font-size: clamp(15px, 1.5vw, 18px); color: #eaeaea; max-width: 520px; margin-bottom: 28px; }
  /* padding-top >= alto del header movil (76px) + aire: el logo del producto quedaba bajo el logo Pewman */
  @media (max-width: 820px) { #PewmanProductHero-{{ section.id }} .pewman-phero__inner { min-height: clamp(460px, 88vw, 580px); padding-top: 96px; padding-bottom: 52px; } }
  @media (max-width: 560px) { #PewmanProductHero-{{ section.id }} .pewman-phero__logo { height: 44px; margin-bottom: 18px; } }
{%- endstyle -%}

{%- liquid
  assign hero_headline = product.metafields.custom.hero_headline.value | default: product.title
  assign hero_image = product.metafields.custom.hero_image.value | default: product.featured_image
-%}
<div id="PewmanProductHero-{{ section.id }}">
  {%- if hero_image -%}
    <img class="pewman-phero__bg" src="{{ hero_image | image_url: width: 1800 }}" alt="{{ hero_headline | escape }}">
  {%- endif -%}
  <div class="pewman-phero__inner">
    {%- if section.settings.logo -%}
      <img class="pewman-phero__logo" src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ product.title | escape }}">
    {%- endif -%}
    <h1 class="pewman-phero__heading">{{ hero_headline }}</h1>
    {%- if section.settings.body_text != blank -%}
      <div class="pewman-phero__body">{{ section.settings.body_text }}</div>
    {%- endif -%}
    <div>{% render 'pewman-cta-button', text: 'Comprar ahora', url: '#pewman-comprar', variant: 'light' %}</div>
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Hero de producto",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo del producto (blanco/monocromo)" },
    { "type": "richtext", "id": "body_text", "label": "Texto (lead)" },
    { "type": "color", "id": "product_accent_color", "label": "Color de acento del producto", "info": "Crioprotect #1499c7 · Nanoforte #009633", "default": "#1499c7" }
  ],
  "presets": [
    { "name": "Pewman · Hero de producto" }
  ]
}
{% endschema %}
