{%- style -%}
  #PewmanPatents-{{ section.id }} { background: #fff; padding: 78px 0; }
  #PewmanPatents-{{ section.id }}.pewman-patents--dark { background: #343434; color: #eafaf2; }
  #PewmanPatents-{{ section.id }}.pewman-patents--dark .pewman-eyebrow { color: #d23a4a; }
  #PewmanPatents-{{ section.id }}.pewman-patents--dark .pewman-section-heading__title { color: #fff; }
  #PewmanPatents-{{ section.id }} .pewman-patents__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanPatents-{{ section.id }} .pewman-patents__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  #PewmanPatents-{{ section.id }}.pewman-patents--condensed .pewman-patents__grid { grid-template-columns: repeat(3, 1fr); }
  #PewmanPatents-{{ section.id }} .pewman-patents__item {
    display: flex; gap: 14px; align-items: center; background: rgba(0,0,0,.03); border: 1px solid var(--pewman-linea);
    border-radius: 14px; padding: 18px 20px; transition: .2s;
  }
  #PewmanPatents-{{ section.id }}.pewman-patents--dark .pewman-patents__item { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.12); }
  #PewmanPatents-{{ section.id }} .pewman-patents__ic { width: 44px; height: 32px; border-radius: 6px; overflow: hidden; flex: none; border: 1px solid var(--pewman-linea); box-shadow: 0 2px 6px rgba(0,0,0,.15); font-size: 0; }
  #PewmanPatents-{{ section.id }}.pewman-patents--dark .pewman-patents__ic { border-color: rgba(255,255,255,.18); box-shadow: 0 2px 6px rgba(0,0,0,.25); }
  #PewmanPatents-{{ section.id }} .pewman-patents__ic svg { width: 100%; height: 100%; display: block; }
  #PewmanPatents-{{ section.id }} .pewman-patents__ic--intl { width: 32px; height: 32px; border-radius: 50%; background: var(--pewman-rojo); border: none; display: flex; align-items: center; justify-content: center; }
  #PewmanPatents-{{ section.id }} .pewman-patents__ic--intl svg { width: 20px; height: 20px; }
  #PewmanPatents-{{ section.id }} .pewman-patents__juris { font-weight: 700; font-size: 16px; }
  #PewmanPatents-{{ section.id }} .pewman-patents__num { font-size: 13.5px; color: var(--pewman-rojo); font-weight: 600; margin: 2px 0 6px; }
  #PewmanPatents-{{ section.id }}.pewman-patents--dark .pewman-patents__num { color: #ff8a99; }
  #PewmanPatents-{{ section.id }} .pewman-patents__desc { font-size: 13.5px; color: var(--pewman-gris-tx); }
  #PewmanPatents-{{ section.id }}.pewman-patents--dark .pewman-patents__desc { color: #cfcfcf; }
  #PewmanPatents-{{ section.id }} .pewman-patents__legal { margin-top: 22px; font-size: 13.5px; color: var(--pewman-gris); text-align: center; }
  @media (max-width: 720px) { #PewmanPatents-{{ section.id }} .pewman-patents__grid, #PewmanPatents-{{ section.id }}.pewman-patents--condensed .pewman-patents__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}

<div id="PewmanPatents-{{ section.id }}" class="{% if section.settings.dark_mode %}pewman-patents--dark{% endif %}{% unless section.settings.show_description %} pewman-patents--condensed{% endunless %}">
  <div class="pewman-patents__wrap">
    {%- if section.settings.heading != blank -%}
      {% render 'pewman-section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subtext: section.settings.subtext %}
    {%- endif -%}
    <div class="pewman-patents__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'patent' -%}
          <div class="pewman-patents__item" {{ block.shopify_attributes }}>
            <div class="pewman-patents__ic{% if block.settings.country == 'intl' %} pewman-patents__ic--intl{% endif %}" aria-label="{{ block.settings.jurisdiction | escape }}" title="{{ block.settings.jurisdiction | escape }}">{% render 'pewman-flag', country: block.settings.country %}</div>
            <div>
              <div class="pewman-patents__juris">{{ block.settings.jurisdiction }}</div>
              <div class="pewman-patents__num">{{ block.settings.registration_number }}</div>
              {%- if section.settings.show_description and block.settings.description != blank -%}
                <p class="pewman-patents__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.legal_note != blank -%}<p class="pewman-patents__legal">{{ section.settings.legal_note }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Patentes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "textarea", "id": "subtext", "label": "Subtítulo" },
    { "type": "checkbox", "id": "show_description", "label": "Mostrar descripción de cada patente", "default": true },
    { "type": "checkbox", "id": "dark_mode", "label": "Fondo oscuro", "default": false },
    { "type": "text", "id": "legal_note", "label": "Nota legal" }
  ],
  "blocks": [
    {
      "type": "patent",
      "name": "Patente",
      "settings": [
        { "type": "select", "id": "country", "label": "País / jurisdicción (ícono)", "options": [ { "value": "intl", "label": "Internacional (globo)" }, { "value": "chile", "label": "Chile" }, { "value": "usa", "label": "Estados Unidos" }, { "value": "india", "label": "India" } ], "default": "intl" },
        { "type": "text", "id": "jurisdiction", "label": "Jurisdicción" },
        { "type": "text", "id": "registration_number", "label": "Número de registro" },
        { "type": "textarea", "id": "description", "label": "Descripción" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pewman · Patentes",
      "blocks": [
        { "type": "patent", "settings": { "country": "intl", "jurisdiction": "Internacional (PCT)", "registration_number": "PCT/CL2021/050061", "description": "Solicitud internacional bajo el Tratado de Cooperación en materia de Patentes." } },
        { "type": "patent", "settings": { "country": "usa", "jurisdiction": "Estados Unidos", "registration_number": "USPTO 63051414", "description": "Registro ante la Oficina de Patentes y Marcas de Estados Unidos (USPTO)." } },
        { "type": "patent", "settings": { "country": "chile", "jurisdiction": "Chile", "registration_number": "N° 1865-2021", "description": "Registro nacional ante INAPI, que protege la tecnología en el mercado chileno." } },
        { "type": "patent", "settings": { "country": "india", "jurisdiction": "India", "registration_number": "N° 509159", "description": "Patente registrada en India, ampliando la cobertura internacional de la tecnología." } }
      ]
    }
  ]
}
{% endschema %}
