{%- style -%}
  #PewmanBenefits-{{ section.id }} { background: #fff; padding: 66px 0; }
  #PewmanBenefits-{{ section.id }} .pewman-benefits__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanBenefits-{{ section.id }} .pewman-benefits__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px; }
  #PewmanBenefits-{{ section.id }} .pewman-benefits__item { text-align: center; padding: 0 10px; }
  #PewmanBenefits-{{ section.id }} .pewman-benefits__icon { display: inline-flex; width: 58px; height: 58px; color: var(--pewman-tinta); margin-bottom: 16px; }
  #PewmanBenefits-{{ section.id }} .pewman-benefits__icon img { width: 100%; height: 100%; object-fit: contain; }
  #PewmanBenefits-{{ section.id }} .pewman-benefits__item p { font-size: 18.75px; color: #5a5a5a; line-height: 1.55; }
  @media (max-width: 820px) { #PewmanBenefits-{{ section.id }} .pewman-benefits__grid { grid-template-columns: 1fr; gap: 30px; max-width: 440px; margin: 0 auto; } }
{%- endstyle -%}

{%- liquid
  assign benefits = product.metafields.custom.key_benefits.value
-%}
<div id="PewmanBenefits-{{ section.id }}">
  <div class="pewman-benefits__wrap">
    <div class="pewman-benefits__grid">
      {%- if benefits.size > 0 -%}
        {%- for benefit in benefits -%}
          <div class="pewman-benefits__item">
            {%- if benefit.icon.value -%}
              <span class="pewman-benefits__icon"><img src="{{ benefit.icon.value | image_url: width: 120 }}" alt=""></span>
            {%- endif -%}
            <div class="pewman-benefits__desc">{{ benefit.description | metafield_tag }}</div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'fallback_benefit' -%}
            <div class="pewman-benefits__item">
              {%- if block.settings.icon -%}<span class="pewman-benefits__icon"><img src="{{ block.settings.icon | image_url: width: 120 }}" alt=""></span>{%- endif -%}
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Beneficios",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Lee product.metafields.custom.key_benefits (metaobjects product_feature). Los blocks de abajo son solo un respaldo visual mientras el metafield no tenga datos." }
  ],
  "blocks": [
    {
      "type": "fallback_benefit",
      "name": "Beneficio (respaldo)",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Ícono" },
        { "type": "text", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pewman · Beneficios",
      "blocks": [
        { "type": "fallback_benefit", "settings": { "text": "Hasta 12 horas de acción frente a temperaturas de hasta −4 °C." } },
        { "type": "fallback_benefit", "settings": { "text": "Reduce entre 80% y 100% del daño en yemas, flores, hojas y tejidos vegetales." } },
        { "type": "fallback_benefit", "settings": { "text": "Hasta 15% más rendimiento gracias a su efecto bioestimulante." } }
      ]
    }
  ]
}
{% endschema %}
