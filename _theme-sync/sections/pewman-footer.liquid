{%- liquid
  assign menu_1 = linklists[section.settings.menu_1]
  assign menu_2 = linklists[section.settings.menu_2]
  assign wa_phone = settings.pewman_whatsapp_phone | default: '56990833908' | remove: '+' | remove: ' '
-%}
{%- style -%}
  #PewmanFooter-{{ section.id }} { background: #181818; color: #b0b0b0; padding: 54px 0 26px; font-size: 14px; }
  #PewmanFooter-{{ section.id }} .pewman-ft__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanFooter-{{ section.id }} .pewman-ft__grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 34px; padding-bottom: 34px; border-bottom: 1px solid #2e2e2e; }
  #PewmanFooter-{{ section.id }} .pewman-ft__logo img { height: 46px; width: auto; margin-bottom: 16px; display: block; }
  #PewmanFooter-{{ section.id }} .pewman-ft__tagline { max-width: 280px; font-size: 14px; margin: 0 0 4px; }
  #PewmanFooter-{{ section.id }} h4 { color: #fff; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 14px; font-weight: 700; }
  #PewmanFooter-{{ section.id }} .pewman-ft__col a { display: block; color: #bcbcbc; margin-bottom: 8px; text-decoration: none; }
  #PewmanFooter-{{ section.id }} .pewman-ft__col a:hover { color: var(--pewman-rojo); }
  #PewmanFooter-{{ section.id }} .pewman-ft__soc { display: flex; gap: 20px; margin-top: 16px; }
  #PewmanFooter-{{ section.id }} .pewman-ft__soc a { display: inline-flex; background: none; margin: 0; opacity: .8; transition: .2s; }
  #PewmanFooter-{{ section.id }} .pewman-ft__soc a svg { width: 23px; height: 23px; display: block; fill: #fff; }
  #PewmanFooter-{{ section.id }} .pewman-ft__soc a:hover { opacity: 1; transform: translateY(-2px); }
  #PewmanFooter-{{ section.id }} .pewman-ft__bot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-top: 20px; font-size: 12.5px; color: #8a8a8a; }
  @media (max-width: 900px) { #PewmanFooter-{{ section.id }} .pewman-ft__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { #PewmanFooter-{{ section.id }} .pewman-ft__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}

<footer id="PewmanFooter-{{ section.id }}">
  <div class="pewman-ft__wrap">
    <div class="pewman-ft__grid">
      <div class="pewman-ft__col">
        {%- if section.settings.logo -%}
          <a class="pewman-ft__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            <img src="{{ section.settings.logo | image_url: width: 260 }}" alt="{{ shop.name | escape }}" width="150" height="46">
          </a>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="pewman-ft__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        <div class="pewman-ft__soc">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.43.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.43.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.43-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.43-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.62c-3.15 0-3.52.01-4.76.07-.9.04-1.39.19-1.71.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.13.32-.28.81-.32 1.71-.06 1.24-.07 1.61-.07 4.76s.01 3.52.07 4.76c.04.9.19 1.39.32 1.71.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.13.81.28 1.71.32 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c.9-.04 1.39-.19 1.71-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.13-.32.28-.81.32-1.71.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.04-.9-.19-1.39-.32-1.71-.17-.43-.37-.74-.69-1.06-.32-.32-.63-.52-1.06-.69-.32-.13-.81-.28-1.71-.32-1.24-.06-1.61-.07-4.76-.07zm0 2.76a5.3 5.3 0 110 10.6 5.3 5.3 0 010-10.6zm0 1.62a3.68 3.68 0 100 7.36 3.68 3.68 0 000-7.36zm5.5-1.39a1.24 1.24 0 110 2.48 1.24 1.24 0 010-2.48z"/></svg></a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg></a>
          {%- endif -%}
          {%- if section.settings.linkedin_url != blank -%}
            <a href="{{ section.settings.linkedin_url }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 110-4.14 2.07 2.07 0 010 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 00.5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 002.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 002.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg></a>
          {%- endif -%}
        </div>
      </div>

      <div class="pewman-ft__col">
        <h4>{{ section.settings.menu_1_title | default: 'Productos' }}</h4>
        {%- for link in menu_1.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>

      <div class="pewman-ft__col">
        <h4>{{ section.settings.menu_2_title | default: 'Empresa' }}</h4>
        {%- for link in menu_2.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>

      <div class="pewman-ft__col">
        <h4>Contacto</h4>
        {%- if section.settings.whatsapp_label != blank -%}
          <a href="https://api.whatsapp.com/send/?phone={{ wa_phone }}" target="_blank" rel="noopener">{{ section.settings.whatsapp_label }}</a>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          {%- if section.settings.maps_url != blank -%}
            {%- assign ft_maps_url = section.settings.maps_url -%}
          {%- else -%}
            {%- assign ft_maps_url = section.settings.address | url_param_escape | prepend: 'https://www.google.com/maps/search/?api=1&query=' -%}
          {%- endif -%}
          <a href="{{ ft_maps_url }}" target="_blank" rel="noopener">{{ section.settings.address }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="pewman-ft__bot">
      <span>{{ section.settings.copyright_text }}</span>
      {%- if section.settings.credit_text != blank -%}<span>{{ section.settings.credit_text }}</span>{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pewman · Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (versión clara)" },
    { "type": "textarea", "id": "tagline", "label": "Descripción breve", "default": "Biotecnología de vanguardia para una agricultura más productiva y sostenible." },
    { "type": "header", "content": "Redes sociales" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "header", "content": "Columna 1" },
    { "type": "text", "id": "menu_1_title", "label": "Título", "default": "Productos" },
    { "type": "link_list", "id": "menu_1", "label": "Menú" },
    { "type": "header", "content": "Columna 2" },
    { "type": "text", "id": "menu_2_title", "label": "Título", "default": "Empresa" },
    { "type": "link_list", "id": "menu_2", "label": "Menú" },
    { "type": "header", "content": "Contacto" },
    { "type": "text", "id": "whatsapp_label", "label": "Texto de WhatsApp", "default": "+56 9 9083 3908" },
    { "type": "text", "id": "address", "label": "Dirección", "default": "Badajoz 100, of. 726, Las Condes, Santiago" },
    { "type": "url", "id": "maps_url", "label": "Link de Google Maps" },
    { "type": "header", "content": "Franja institucional" },
    { "type": "text", "id": "copyright_text", "label": "Copyright", "default": "© 2026 Pewman Innovation SPA. Todos los derechos reservados." },
    { "type": "text", "id": "credit_text", "label": "Crédito", "default": "Sitio desarrollado por Clo&Co." }
  ]
}
{% endschema %}
