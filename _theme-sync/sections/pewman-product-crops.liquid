{%- style -%}
  #PewmanCrops-{{ section.id }} {
    background: #fff; padding: 78px 0;
    --pewman-prod: {{ section.settings.product_accent_color | default: '#1499c7' }};
  }
  #PewmanCrops-{{ section.id }} .pewman-crops__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanCrops-{{ section.id }} .pewman-crops__head { text-align: center; max-width: 680px; margin: 0 auto 26px; }
  #PewmanCrops-{{ section.id }} .pewman-crops__head .pewman-eyebrow { color: var(--pewman-prod); }
  #PewmanCrops-{{ section.id }} .pewman-crops__list {
    max-width: 840px; margin: 0 auto; text-align: center; font-weight: 600;
    font-size: clamp(15px, 1.7vw, 19px); line-height: 2.1; color: var(--pewman-prod);
  }
{%- endstyle -%}

{%- liquid
  assign crops = product.metafields.custom.compatible_crops.value
-%}
<div id="PewmanCrops-{{ section.id }}">
  <div class="pewman-crops__wrap">
    <div class="pewman-crops__head">
      <span class="pewman-eyebrow">Compatibilidad</span>
      <h2>{{ section.settings.heading | default: '¿En qué cultivos lo aplico?' }}</h2>
    </div>
    <p class="pewman-crops__list">
      {%- if crops.size > 0 -%}
        {%- for crop in crops -%}{{ crop.name.value }}{% unless forloop.last %} | {% endunless %}{%- endfor -%}
      {%- else -%}
        {{ section.settings.fallback_list }}
      {%- endif -%}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Cultivos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¿En qué cultivos lo aplico?" },
    { "type": "color", "id": "product_accent_color", "label": "Color de acento del producto", "default": "#1499c7" },
    { "type": "textarea", "id": "fallback_list", "label": "Lista de respaldo (separada por \" | \")", "info": "Se usa mientras product.metafields.custom.compatible_crops no tenga datos" }
  ],
  "presets": [
    {
      "name": "Pewman · Cultivos",
      "settings": { "fallback_list": "Acelga | Ají | Brócoli | Coliflor | Espárrago | Frutilla | Lechuga | Melón | Pimentón | Repollo | Sandía | Tomate | Zanahoria | Zapallo guarda | Zapallo italiano | Papas | Choclo | Cerezo | Duraznero | Manzanero | Cítricos" }
    }
  ]
}
{% endschema %}
