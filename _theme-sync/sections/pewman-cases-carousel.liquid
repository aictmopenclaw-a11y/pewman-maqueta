{%- style -%}
  #PewmanCases-{{ section.id }} { background: var(--pewman-crema); padding: 78px 0; }
  #PewmanCases-{{ section.id }} .pewman-cases__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanCases-{{ section.id }} .pewman-cases__track { display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 14px; scrollbar-width: none; }
  #PewmanCases-{{ section.id }} .pewman-cases__track::-webkit-scrollbar { display: none; }
  #PewmanCases-{{ section.id }} .pewman-cases__card {
    flex: 0 0 auto; width: 300px; height: 360px; border-radius: 18px; overflow: hidden; position: relative;
    scroll-snap-align: center; box-shadow: var(--pewman-sh); display: block;
  }
  #PewmanCases-{{ section.id }} .pewman-cases__card img { width: 100%; height: 100%; object-fit: cover; transition: .4s; }
  #PewmanCases-{{ section.id }} .pewman-cases__card:hover img { transform: scale(1.06); }
  #PewmanCases-{{ section.id }} .pewman-cases__label {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 30px 16px 16px;
    background: linear-gradient(transparent, rgba(20,20,20,.82)); color: #fff; font-weight: 700; font-size: 16px;
  }
  #PewmanCases-{{ section.id }} .pewman-cases__nav { display: flex; gap: 10px; justify-content: center; margin-top: 22px; }
  #PewmanCases-{{ section.id }} .pewman-cases__nav button {
    width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--pewman-linea); background: #fff;
    cursor: pointer; font-size: 18px; color: var(--pewman-tinta); transition: .2s;
  }
  #PewmanCases-{{ section.id }} .pewman-cases__nav button:hover { background: var(--pewman-rojo); color: #fff; border-color: var(--pewman-rojo); }
  #PewmanCases-{{ section.id }} .pewman-cases__more { text-align: center; margin-top: 26px; }
{%- endstyle -%}

<div id="PewmanCases-{{ section.id }}" aria-label="Casos de éxito">
  <div class="pewman-cases__wrap">
    {% render 'pewman-section-heading', eyebrow: section.settings.eyebrow | default: 'Resultados', heading: section.settings.heading | default: 'Casos de éxito', subtext: section.settings.subtext %}
    <pewman-horizontal-scroller data-step="318">
      <div class="pewman-cases__track" data-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'case_card' -%}
            <a class="pewman-cases__card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.label | escape }}" loading="lazy">
              {%- endif -%}
              <div class="pewman-cases__label">{{ block.settings.label }}</div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="pewman-cases__nav">
        <button type="button" data-dir="-1" aria-label="Anterior">‹</button>
        <button type="button" data-dir="1" aria-label="Siguiente">›</button>
      </div>
    </pewman-horizontal-scroller>
    {%- if section.settings.view_all_link != blank -%}
      <div class="pewman-cases__more">
        {% render 'pewman-cta-button', text: section.settings.view_all_label | default: 'Ver todos los casos de éxito', url: section.settings.view_all_link, variant: 'light' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Casos de éxito",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Resultados" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Casos de éxito" },
    { "type": "text", "id": "subtext", "label": "Subtítulo", "default": "Probado en los cultivos de Chile." },
    { "type": "url", "id": "view_all_link", "label": "Link \"Ver todos\"" },
    { "type": "text", "id": "view_all_label", "label": "Texto \"Ver todos\"", "default": "Ver todos los casos de éxito" }
  ],
  "blocks": [
    {
      "type": "case_card",
      "name": "Caso",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "label", "label": "Etiqueta" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pewman · Casos de éxito",
      "blocks": [
        { "type": "case_card", "settings": { "label": "Durazno" } },
        { "type": "case_card", "settings": { "label": "Kiwis" } },
        { "type": "case_card", "settings": { "label": "Paltos" } },
        { "type": "case_card", "settings": { "label": "Papas" } },
        { "type": "case_card", "settings": { "label": "Lechugas y coliflor" } },
        { "type": "case_card", "settings": { "label": "Viña Concha y Toro" } }
      ]
    }
  ]
}
{% endschema %}
