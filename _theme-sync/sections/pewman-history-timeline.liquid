{%- style -%}
  #PewmanTimeline-{{ section.id }} { background: var(--pewman-crema); padding: 78px 0; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__list { position: relative; max-width: 880px; margin: 0 auto; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__list::before { content: ""; position: absolute; left: 19px; top: 14px; bottom: 14px; width: 2px; background: var(--pewman-linea); }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__item { position: relative; padding: 0 0 26px 66px; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__item:last-child { padding-bottom: 0; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__num {
    position: absolute; left: 0; top: 0; width: 40px; height: 40px; border-radius: 50%; background: var(--pewman-rojo);
    color: #fff; font-weight: 800; font-size: 16px; display: flex; align-items: center; justify-content: center; z-index: 1;
    box-shadow: 0 6px 16px -4px rgba(189,0,40,.5);
  }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__card {
    background: #fff; border: 1px solid var(--pewman-linea); border-radius: 16px; box-shadow: var(--pewman-sh);
    overflow: hidden; display: grid; grid-template-columns: 210px 1fr; transition: .2s;
  }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__card:hover { transform: translateY(-2px); }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__card.no-img { grid-template-columns: 1fr; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__card > img { width: 100%; height: 100%; object-fit: cover; min-height: 190px; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__tx { padding: 24px 28px; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__tx h3 { font-size: 20px; color: var(--pewman-tinta); margin: 7px 0 11px; line-height: 1.22; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__body p { color: var(--pewman-gris-tx); font-size: 15px; margin-bottom: 9px; }
  #PewmanTimeline-{{ section.id }} .pewman-timeline__chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  @media (max-width: 680px) {
    #PewmanTimeline-{{ section.id }} .pewman-timeline__item { padding-left: 50px; }
    #PewmanTimeline-{{ section.id }} .pewman-timeline__list::before { left: 16px; }
    #PewmanTimeline-{{ section.id }} .pewman-timeline__num { width: 34px; height: 34px; font-size: 14px; }
    #PewmanTimeline-{{ section.id }} .pewman-timeline__card { grid-template-columns: 1fr; }
    #PewmanTimeline-{{ section.id }} .pewman-timeline__card > img { min-height: 150px; max-height: 200px; }
    #PewmanTimeline-{{ section.id }} .pewman-timeline__tx { padding: 20px 22px; }
  }
{%- endstyle -%}

<div id="PewmanTimeline-{{ section.id }}">
  <div class="pewman-timeline__wrap">
    {% render 'pewman-section-heading', eyebrow: section.settings.eyebrow | default: 'Nuestra historia', heading: section.settings.heading | default: 'El camino de Pewman Innovation', subtext: section.settings.subtext %}
    <div class="pewman-timeline__list">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Timeline",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nuestra historia" },
    { "type": "text", "id": "heading", "label": "Título", "default": "El camino de Pewman Innovation" },
    { "type": "text", "id": "subtext", "label": "Subtítulo", "default": "De los ecosistemas más extremos del planeta a soluciones que hoy protegen cultivos en Chile y el mundo." }
  ],
  "blocks": [
    { "type": "pewman-timeline-item" }
  ],
  "presets": [
    { "name": "Pewman · Timeline", "blocks": [{ "type": "pewman-timeline-item" }] }
  ]
}
{% endschema %}
