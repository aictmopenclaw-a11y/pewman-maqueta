{%- style -%}
  #PewmanAwardsEmpresa-{{ section.id }} { background: #fff; padding: 78px 0; }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__top { display: flex; justify-content: center; margin-bottom: 46px; }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__top-card {
    display: flex; gap: 20px; align-items: center; background: linear-gradient(155deg, #fff, var(--pewman-crema));
    border: 1px solid var(--pewman-linea); border-radius: 26px; padding: 26px; box-shadow: var(--pewman-sh); max-width: 500px;
  }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__top-card img { width: 110px; height: 110px; object-fit: contain; flex: none; }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__top-card h3 { font-size: 22px; color: var(--pewman-tinta); margin: 0; }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__top-card p { font-size: 14px; color: var(--pewman-gris-tx); margin-top: 6px; }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__logos { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__logo-box { background: #fff; border: 1px solid var(--pewman-linea); border-radius: 12px; height: 74px; width: 128px; display: flex; align-items: center; justify-content: center; padding: 12px; }
  #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__logo-box img { max-height: 46px; max-width: 104px; object-fit: contain; }
  @media (max-width: 620px) { #PewmanAwardsEmpresa-{{ section.id }} .pewman-ae__top-card { flex-direction: column; text-align: center; max-width: 100%; } }
{%- endstyle -%}

<div id="PewmanAwardsEmpresa-{{ section.id }}">
  <div class="pewman-ae__wrap">
    {% render 'pewman-section-heading', eyebrow: section.settings.eyebrow | default: 'Reconocimientos', heading: section.settings.heading | default: 'Premios y respaldo', subtext: section.settings.subtext %}
    {%- if section.settings.featured_title != blank -%}
      <div class="pewman-ae__top">
        <div class="pewman-ae__top-card">
          {%- if section.settings.featured_image -%}<img src="{{ section.settings.featured_image | image_url: width: 300 }}" alt="{{ section.settings.featured_title | escape }}">{%- endif -%}
          <div><h3>{{ section.settings.featured_title }}</h3><p>{{ section.settings.featured_text }}</p></div>
        </div>
      </div>
    {%- endif -%}
    <div class="pewman-ae__logos">
      {%- for block in section.blocks -%}
        {%- if block.type == 'award_logo' and block.settings.logo -%}
          <div class="pewman-ae__logo-box"><img src="{{ block.settings.logo | image_url: width: 260 }}" alt="{{ block.settings.alt | escape }}"></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Premios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reconocimientos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Premios y respaldo" },
    { "type": "textarea", "id": "subtext", "label": "Subtítulo" },
    { "type": "text", "id": "featured_title", "label": "Premio destacado — título", "default": "Startup del Año 2024" },
    { "type": "textarea", "id": "featured_text", "label": "Premio destacado — descripción" },
    { "type": "image_picker", "id": "featured_image", "label": "Premio destacado — imagen" }
  ],
  "blocks": [
    {
      "type": "award_logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pewman · Premios",
      "settings": { "subtext": "Nuestro crecimiento ha sido acompañado por reconocimientos nacionales e internacionales en innovación, emprendimiento científico y transferencia tecnológica.", "featured_text": "Reconocimiento de El Mercurio Innovación, junto a Swiss Business Hub USA, PwC, Nestlé y Corfo." },
      "blocks": [{ "type": "award_logo" }, { "type": "award_logo" }, { "type": "award_logo" }, { "type": "award_logo" }]
    }
  ]
}
{% endschema %}
