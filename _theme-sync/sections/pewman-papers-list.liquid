{%- comment -%}
  Artículos y papers. Dos fuentes posibles, misma tarjeta de la maqueta:
  · "blog"   → lee los artículos reales del blog elegido (nativo, SEO, RSS,
               administrable desde Admin → Contenido → Entradas de blog).
  · "manual" → tarjetas fijas por block (respaldo si aún no hay blog).
  El tag sale del primer tag del artículo; la meta, del resumen.
{%- endcomment -%}
{%- liquid
  assign use_blog = false
  if section.settings.source == 'blog' and section.settings.blog != blank
    assign the_blog = blogs[section.settings.blog]
    if the_blog.articles_count > 0
      assign use_blog = true
    endif
  endif
-%}
{%- style -%}
  #PewmanPapers-{{ section.id }} { background: {% if section.settings.cream_bg %}var(--pewman-crema){% else %}#fff{% endif %}; padding: 78px 0; }
  #PewmanPapers-{{ section.id }} .pewman-papers__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanPapers-{{ section.id }} .pewman-papers__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  #PewmanPapers-{{ section.id }} .pewman-papers__card {
    display: flex; flex-direction: column; background: #fff; border: 1px solid var(--pewman-linea); border-radius: 16px;
    padding: 22px 24px; transition: .2s; height: 100%; text-decoration: none;
  }
  #PewmanPapers-{{ section.id }} .pewman-papers__card:hover { box-shadow: var(--pewman-sh); transform: translateY(-3px); }
  #PewmanPapers-{{ section.id }} .pewman-papers__tag {
    display: inline-block; align-self: flex-start; font-weight: 700; font-size: 10.5px; letter-spacing: .05em; text-transform: uppercase;
    color: #fff; background: #727272; padding: 3px 9px; border-radius: 4px; margin-bottom: 12px;
  }
  #PewmanPapers-{{ section.id }} .pewman-papers__card h3 { font-size: 16px; color: var(--pewman-tinta); line-height: 1.32; margin-bottom: 10px; }
  #PewmanPapers-{{ section.id }} .pewman-papers__meta { font-size: 12.5px; color: var(--pewman-gris); margin-top: auto; }
  #PewmanPapers-{{ section.id }} .pewman-papers__go { font-weight: 600; font-size: 12.5px; color: var(--pewman-rojo); margin-top: 10px; }
  #PewmanPapers-{{ section.id }} .pewman-papers__legal { margin-top: 22px; font-size: 13.5px; color: var(--pewman-gris); text-align: center; }
  #PewmanPapers-{{ section.id }} .pewman-papers__all { text-align: center; margin-top: 30px; }
  @media (max-width: 860px) { #PewmanPapers-{{ section.id }} .pewman-papers__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { #PewmanPapers-{{ section.id }} .pewman-papers__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}

<div id="PewmanPapers-{{ section.id }}">
  <div class="pewman-papers__wrap">
    {% render 'pewman-section-heading', eyebrow: section.settings.eyebrow | default: 'Ciencia', heading: section.settings.heading | default: 'Artículos y papers', subtext: section.settings.subtext %}
    <div class="pewman-papers__grid">
      {%- if use_blog -%}
        {%- for article in the_blog.articles limit: section.settings.max_articles -%}
          <a class="pewman-papers__card" href="{{ article.url }}">
            {%- if article.tags.size > 0 -%}<span class="pewman-papers__tag">{{ article.tags.first }}</span>{%- endif -%}
            <h3>{{ article.title }}</h3>
            {%- if article.excerpt_or_content != blank -%}
              <div class="pewman-papers__meta">{{ article.excerpt_or_content | strip_html | truncate: 90 }}</div>
            {%- endif -%}
            <span class="pewman-papers__go">Leer &rarr;</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'paper' -%}
            <div class="pewman-papers__card" {{ block.shopify_attributes }}>
              <span class="pewman-papers__tag">{{ block.settings.tag }}</span>
              <h3>{{ block.settings.title }}</h3>
              <div class="pewman-papers__meta">{{ block.settings.meta }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if use_blog and section.settings.show_view_all -%}
      <div class="pewman-papers__all">{% render 'pewman-cta-button', text: 'Ver todos los artículos →', url: the_blog.url, variant: 'light' %}</div>
    {%- endif -%}
    {%- if section.settings.legal_note != blank -%}<p class="pewman-papers__legal">{{ section.settings.legal_note }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Papers",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Origen del contenido",
      "options": [
        { "value": "blog", "label": "Blog de Shopify (recomendado)" },
        { "value": "manual", "label": "Tarjetas fijas" }
      ],
      "default": "blog",
      "info": "Con el blog, publicas desde Contenido → Entradas de blog y aparecen solas acá"
    },
    { "type": "blog", "id": "blog", "label": "Blog", "visible_if": "{{ section.settings.source == 'blog' }}" },
    { "type": "range", "id": "max_articles", "label": "Cuántos mostrar", "min": 3, "max": 12, "step": 1, "default": 6, "visible_if": "{{ section.settings.source == 'blog' }}" },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar botón \"Ver todos\"", "default": true, "visible_if": "{{ section.settings.source == 'blog' }}" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ciencia" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Artículos y papers" },
    { "type": "textarea", "id": "subtext", "label": "Subtítulo" },
    { "type": "checkbox", "id": "cream_bg", "label": "Fondo crema", "default": true },
    { "type": "text", "id": "legal_note", "label": "Nota legal" }
  ],
  "blocks": [
    {
      "type": "paper",
      "name": "Paper/Artículo",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "info": "Ej. Paper, Artículo" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "text", "id": "meta", "label": "Meta (línea descriptiva)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pewman · Papers",
      "settings": { "source": "blog" }
    }
  ]
}
{% endschema %}
