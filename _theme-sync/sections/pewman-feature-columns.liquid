{%- style -%}
  #PewmanFeatureCols-{{ section.id }} { background: #fff; padding: 78px 0; }
  #PewmanFeatureCols-{{ section.id }} .pewman-fc__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  #PewmanFeatureCols-{{ section.id }} .pewman-fc__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  #PewmanFeatureCols-{{ section.id }} .pewman-fc__card { background: var(--pewman-crema); border: 1px solid var(--pewman-linea); border-radius: 18px; padding: 26px; }
  #PewmanFeatureCols-{{ section.id }} .pewman-fc__card h3 { font-size: 18px; color: var(--pewman-tinta); margin-bottom: 8px; }
  #PewmanFeatureCols-{{ section.id }} .pewman-fc__card p { font-size: 14px; color: var(--pewman-gris-tx); margin: 0; }
  @media (max-width: 720px) { #PewmanFeatureCols-{{ section.id }} .pewman-fc__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}

<div id="PewmanFeatureCols-{{ section.id }}">
  <div class="pewman-fc__wrap">
    {% render 'pewman-section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="pewman-fc__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="pewman-fc__card"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Columnas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hacia dónde vamos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Propósito y visión" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Tarjeta",
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pewman · Propósito",
      "blocks": [
        { "type": "feature", "settings": { "title": "Nuestro propósito", "text": "Fortalecer la resiliencia de la agricultura mediante tecnologías biológicas desarrolladas a partir de microorganismos de ecosistemas extremos." } },
        { "type": "feature", "settings": { "title": "Nuestra visión", "text": "Convertirnos en referentes globales en biotecnología agrícola, llevando innovación desarrollada en Chile hacia los principales mercados agrícolas del mundo." } }
      ]
    }
  ]
}
{% endschema %}
