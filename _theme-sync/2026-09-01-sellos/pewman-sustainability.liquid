{%- comment -%}
  Sostenibilidad · página Empresa (va entre "Propósito y visión" y el Equipo).
  Fondo crema para dar respiro entre dos secciones blancas. Encabezado con el
  snippet compartido. Banner (image_picker, con fallback verde), párrafo de
  política, pilares (bloques), franja de certificaciones y descargables (bloques).
{%- endcomment -%}
{%- style -%}
  #PewmanSustain-{{ section.id }} { background: var(--pewman-crema); padding: 78px 0; }
  #PewmanSustain-{{ section.id }} .pewman-sus__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

  #PewmanSustain-{{ section.id }} .pewman-sus__banner {
    position: relative; border-radius: 22px; overflow: hidden; margin: 34px 0 40px; min-height: 320px;
    display: flex; align-items: flex-end; box-shadow: var(--pewman-sh);
    background: linear-gradient(120deg, #0f3b26 0%, #2f7d52 48%, #5fae74 100%);
  }
  #PewmanSustain-{{ section.id }} .pewman-sus__banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #PewmanSustain-{{ section.id }} .pewman-sus__banner::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,40,26,.1) 30%, rgba(15,40,26,.72) 100%); }
  #PewmanSustain-{{ section.id }} .pewman-sus__banner-in { position: relative; z-index: 1; padding: 36px 40px; color: #fff; max-width: 640px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__banner-in h3 { font-size: clamp(22px, 2.6vw, 30px); font-weight: 700; line-height: 1.2; margin: 0 0 8px; color: #fff; }
  #PewmanSustain-{{ section.id }} .pewman-sus__banner-in p { font-size: 15px; opacity: .95; margin: 0; }

  #PewmanSustain-{{ section.id }} .pewman-sus__policy { max-width: 900px; margin: 0 auto 44px; font-size: 16.5px; color: var(--pewman-gris-tx); text-align: center; }
  #PewmanSustain-{{ section.id }} .pewman-sus__policy p { margin: 0; }

  #PewmanSustain-{{ section.id }} .pewman-sus__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__card { background: #fff; border: 1px solid var(--pewman-linea); border-radius: 18px; padding: 26px 24px; transition: .2s; }
  #PewmanSustain-{{ section.id }} .pewman-sus__card:hover { transform: translateY(-3px); box-shadow: var(--pewman-sh); }
  #PewmanSustain-{{ section.id }} .pewman-sus__ic { width: 46px; height: 46px; border-radius: 12px; background: var(--pewman-crema); border: 1px solid var(--pewman-linea); display: flex; align-items: center; justify-content: center; color: var(--pewman-rojo); margin-bottom: 16px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__ic svg { width: 24px; height: 24px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__fig { font-size: 26px; font-weight: 800; color: var(--pewman-rojo); line-height: 1; margin-bottom: 4px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__card h4 { font-size: 17px; font-weight: 700; color: var(--pewman-tinta); margin: 0 0 7px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__card p { font-size: 14.5px; color: var(--pewman-gris-tx); margin: 0; }

  #PewmanSustain-{{ section.id }} .pewman-sus__certs { display: flex; align-items: center; justify-content: center; gap: 34px; flex-wrap: wrap; margin: 40px auto 0; padding: 22px 26px; background: #fff; border: 1px solid var(--pewman-linea); border-radius: 16px; max-width: 760px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__certs .lbl { font-size: 14px; color: var(--pewman-gris-tx); }
  #PewmanSustain-{{ section.id }} .pewman-sus__certs img { height: 104px; width: auto; object-fit: contain; }

  #PewmanSustain-{{ section.id }} .pewman-sus__docs { margin-top: 52px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__docs-head { text-align: center; margin-bottom: 22px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__docs-head h3 { font-size: 22px; font-weight: 700; color: var(--pewman-tinta); margin: 6px 0 0; }
  #PewmanSustain-{{ section.id }} .pewman-sus__docs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; max-width: 720px; margin: 0 auto; }
  #PewmanSustain-{{ section.id }} .pewman-sus__doc { display: flex; flex-direction: column; gap: 12px; background: #fff; border: 1px solid var(--pewman-linea); border-radius: 14px; padding: 20px; text-decoration: none; color: inherit; transition: .2s; }
  #PewmanSustain-{{ section.id }} .pewman-sus__doc:hover { border-color: var(--pewman-rojo); transform: translateY(-3px); box-shadow: var(--pewman-sh); }
  #PewmanSustain-{{ section.id }} .pewman-sus__doc-ic { width: 40px; height: 40px; border-radius: 10px; background: #fdeef0; color: var(--pewman-rojo); display: flex; align-items: center; justify-content: center; }
  #PewmanSustain-{{ section.id }} .pewman-sus__doc-ic svg { width: 22px; height: 22px; }
  #PewmanSustain-{{ section.id }} .pewman-sus__doc-t { font-size: 14.5px; font-weight: 600; color: var(--pewman-tinta); line-height: 1.3; }
  #PewmanSustain-{{ section.id }} .pewman-sus__doc-m { font-size: 12.5px; color: var(--pewman-gris); margin-top: auto; }

  @media (max-width: 860px) { #PewmanSustain-{{ section.id }} .pewman-sus__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    #PewmanSustain-{{ section.id }} .pewman-sus__grid,
    #PewmanSustain-{{ section.id }} .pewman-sus__docs-grid { grid-template-columns: 1fr; }
    #PewmanSustain-{{ section.id }} .pewman-sus__banner-in { padding: 26px 22px; }
    #PewmanSustain-{{ section.id }} .pewman-sus__certs { gap: 22px; }
    #PewmanSustain-{{ section.id }} .pewman-sus__certs img { height: 72px; }
  }
  {%- comment -%} Icono propio: llena la casilla completa, para logos como los ODS. {%- endcomment -%}
  #PewmanSustain-{{ section.id }} .pewman-sust__icon-img { width: 100%; height: 100%; object-fit: contain; border-radius: 6px; display: block; }
{%- endstyle -%}

<div id="PewmanSustain-{{ section.id }}">
  <div class="pewman-sus__wrap">
    {% render 'pewman-section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subtext: section.settings.subtext %}

    {%- if section.settings.banner_heading != blank or section.settings.banner_image -%}
      <div class="pewman-sus__banner">
        {%- if section.settings.banner_image -%}
          <img src="{{ section.settings.banner_image | image_url: width: 1600 }}" alt="{{ section.settings.banner_heading | escape }}" loading="lazy" width="1600" height="600">
        {%- endif -%}
        <div class="pewman-sus__banner-in">
          {%- if section.settings.banner_heading != blank -%}<h3>{{ section.settings.banner_heading }}</h3>{%- endif -%}
          {%- if section.settings.banner_text != blank -%}<p>{{ section.settings.banner_text }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.policy != blank -%}
      <div class="pewman-sus__policy">{{ section.settings.policy }}</div>
    {%- endif -%}

    <div class="pewman-sus__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          <div class="pewman-sus__card" {{ block.shopify_attributes }}>
            <div class="pewman-sus__ic">
              {%- comment -%}
                Imagen propia por pilar (Denisse 2026-08-18, ODS de FAO): la lista
                de iconos SVG es cerrada, asi que sin esto no se pueden cargar los
                ODS ni ningun icono nuevo sin tocar codigo. Si hay imagen, manda.
              {%- endcomment -%}
              {%- if block.settings.icon_image != blank -%}
                <img class="pewman-sust__icon-img" src="{{ block.settings.icon_image | image_url: width: 160 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'water' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.7S5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 12 2.7 12 2.7Z"/></svg>
                {%- when 'carbon' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a4 4 0 0 0 0-8 6 6 0 0 0-11.5-1.5A3.5 3.5 0 0 0 6 18Z"/><path d="M8 21c1-1.2 2-1.2 3 0"/><path d="M13 21c1-1.2 2-1.2 3 0"/></svg>
                {%- when 'soil' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v6"/><path d="M12 9c-2 0-4 1.5-4 4m4-4c2 0 4 1.5 4 4"/><path d="M4 13h16l-1.5 6.5a2 2 0 0 1-2 1.5H7.5a2 2 0 0 1-2-1.5Z"/></svg>
                {%- when 'microbe' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><path d="M9.6 10.4 6.5 7.4M14.4 10.4l3-3M10 14l-2.6 2.6"/></svg>
                {%- when 'certified' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 1.7 2.9-.2 1 2.8 2.4 1.6-.7 2.8.7 2.8-2.4 1.6-1 2.8-2.9-.2L12 22l-2.4-1.7-2.9.2-1-2.8L3.3 16 4 13.2 3.3 10.4l2.4-1.6 1-2.8 2.9.2Z"/><path d="m9 12 2 2 4-4"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 4 13c0-4 3-8 9-9 0 6-2 9-6 10"/><path d="M4 20c3-4 6-6 10-7"/></svg>
              {%- endcase -%}
              {%- endif -%}
            </div>
            {%- if block.settings.figure != blank -%}<div class="pewman-sus__fig">{{ block.settings.figure }}</div>{%- endif -%}
            <h4>{{ block.settings.title }}</h4>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cert_logo_1 or section.settings.cert_logo_2 -%}
      <div class="pewman-sus__certs">
        {%- if section.settings.cert_label != blank -%}<span class="lbl">{{ section.settings.cert_label }}</span>{%- endif -%}
        {%- if section.settings.cert_logo_1 -%}<img src="{{ section.settings.cert_logo_1 | image_url: width: 400 }}" alt="Certificación" loading="lazy" width="100" height="66">{%- endif -%}
        {%- if section.settings.cert_logo_2 -%}<img src="{{ section.settings.cert_logo_2 | image_url: width: 400 }}" alt="Certificación" loading="lazy" width="100" height="66">{%- endif -%}
      </div>
    {%- endif -%}

    {%- assign has_docs = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'doc' -%}{%- assign has_docs = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_docs -%}
      <div class="pewman-sus__docs">
        <div class="pewman-sus__docs-head">
          {%- if section.settings.docs_eyebrow != blank -%}<span class="pewman-eyebrow">{{ section.settings.docs_eyebrow }}</span>{%- endif -%}
          {%- if section.settings.docs_heading != blank -%}<h3>{{ section.settings.docs_heading }}</h3>{%- endif -%}
        </div>
        <div class="pewman-sus__docs-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'doc' -%}
              <a class="pewman-sus__doc" href="{{ block.settings.url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                <div class="pewman-sus__doc-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/></svg></div>
                <span class="pewman-sus__doc-t">{{ block.settings.title }}</span>
                {%- if block.settings.meta != blank -%}<span class="pewman-sus__doc-m">{{ block.settings.meta }}</span>{%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pewman · Sostenibilidad",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compromiso" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Sostenibilidad" },
    { "type": "textarea", "id": "subtext", "label": "Bajada" },
    { "type": "header", "content": "Banner" },
    { "type": "image_picker", "id": "banner_image", "label": "Imagen del banner" },
    { "type": "text", "id": "banner_heading", "label": "Título del banner", "default": "Agricultura limpia, circular y regenerativa" },
    { "type": "textarea", "id": "banner_text", "label": "Texto del banner" },
    { "type": "header", "content": "Política" },
    { "type": "richtext", "id": "policy", "label": "Párrafo de política" },
    { "type": "header", "content": "Certificaciones" },
    { "type": "text", "id": "cert_label", "label": "Etiqueta", "default": "Certificaciones" },
    { "type": "image_picker", "id": "cert_logo_1", "label": "Logo 1 (SAG)" },
    { "type": "image_picker", "id": "cert_logo_2", "label": "Logo 2 (Ecocert)" },
    { "type": "header", "content": "Descargables" },
    { "type": "text", "id": "docs_eyebrow", "label": "Eyebrow", "default": "Transparencia" },
    { "type": "text", "id": "docs_heading", "label": "Título", "default": "Documentos y reportes" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilar",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Ícono propio (opcional)", "info": "Reemplaza al ícono de la lista. Úsalo para los ODS o cualquier ícono nuevo. Cuadrado, PNG o SVG." },
        { "type": "select", "id": "icon", "label": "Ícono", "default": "leaf", "options": [
          { "value": "leaf", "label": "Hoja (orgánico)" },
          { "value": "water", "label": "Gota (agua)" },
          { "value": "carbon", "label": "Nube (huella de carbono)" },
          { "value": "soil", "label": "Suelo / raíces" },
          { "value": "microbe", "label": "Microorganismo" },
          { "value": "certified", "label": "Certificado" }
        ] },
        { "type": "text", "id": "figure", "label": "Cifra destacada (opcional)" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    },
    {
      "type": "doc",
      "name": "Descargable",
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "url", "label": "Archivo o enlace" },
        { "type": "text", "id": "meta", "label": "Detalle (ej. PDF · 26 págs)" }
      ]
    }
  ],
  "presets": [
    { "name": "Pewman · Sostenibilidad" }
  ]
}
{% endschema %}